# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Database — switch by commenting/uncommenting one pair below
# =============================================================================

# Local Postgres (development). Encode special chars in password (@ → %40)
DATABASE_URL="postgresql://postgres:Root%40123@localhost:5432/propintel?schema=public"
DIRECT_URL="postgresql://postgres:Root%40123@localhost:5432/propintel?schema=public"

# Neon PostgreSQL (remote / production). Comment local pair, then uncomment:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=30"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login?tab=register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# =============================================================================
# Stripe — leave placeholders until you paste Dashboard → Developers → API keys
# Webhook endpoint: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#         customer.subscription.deleted
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Optional AI
# OPENAI_API_KEY=

# Google Meet (Calendar API) — required for live coaching Meet links
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=America/New_York
# GOOGLE_REDIRECT_URI=http://localhost:3000

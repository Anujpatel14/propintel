# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# Required for local app: App URL, Database, Clerk
# Strongly recommended: Stripe (billing), OpenRouter (AI analyzer)
# Optional: Google Meet (coaching), OpenAI fallback, LOG_VERBOSE

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Database — switch by commenting/uncommenting one pair below
# Local Postgres (fast for development). Encode special chars in password
#   e.g. password Root@123 → Root%40123  (@ → %40)
# =============================================================================
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/propintel?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/propintel?schema=public"

# Neon PostgreSQL (remote). Comment local pair above, then uncomment these:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=30"

# =============================================================================
# Session / admin panel credentials
# Admin login URL: /pintel-4dmin-p4n3l-9f2a
# =============================================================================
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=propintel@admin
ADMIN_PASSWORD=PropIntel@Admin@2026!!

# =============================================================================
# Clerk Authentication
# Dashboard → https://dashboard.clerk.com → API Keys
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login?tab=register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# =============================================================================
# Stripe — Dashboard → Developers → API keys
# Webhook endpoint: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Suggested events: checkout.session.completed, invoice.paid,
#   invoice.payment_failed, customer.subscription.deleted
# STRIPE_PRICE_* can be a Stripe price_… ID OR a dollar amount (e.g. 49)
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=49
STRIPE_PRICE_PRO_ANNUAL=39
STRIPE_PRICE_ENTERPRISE_MONTHLY=99
STRIPE_PRICE_ENTERPRISE_ANNUAL=79

# =============================================================================
# AI — OpenRouter (preferred for deal analysis)
# https://openrouter.ai/keys — model defaults to openrouter/free
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free

# Optional OpenAI fallback if OpenRouter is unset
# OPENAI_API_KEY=sk-...

# =============================================================================
# Google Meet (Calendar API) — live Meet links for coaching
# =============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=America/New_York
# GOOGLE_REDIRECT_URI=http://localhost:3000

# =============================================================================
# ATTOM Property Data API — Property Explorer + Analyzer lookup
# Dashboard → https://api.developer.attomdata.com/ — never expose to the client
# =============================================================================
ATTOM_API_KEY=
# Optional override (default: https://api.gateway.attomdata.com/propertyapi/v1.0.0)
# ATTOM_API_BASE_URL=

# =============================================================================
# Logging (optional)
# Set to 1 to print verbose request logs to the console
# =============================================================================
# LOG_VERBOSE=1
